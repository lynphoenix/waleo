## 7. 使用场景

### 7.1 仿真训练

```python
from waleo_env.tasks import make_vec_env
from waleo_policy_act import ACTPolicy
from torch.utils.data import DataLoader

# 创建并行环境
vec_env = make_vec_env(
    task="pick_place",
    num_envs=512,
    simulation_backend="isaacgym",  # GPU 加速
    asynchronous=True
)

# 加载策略
policy = ACTPolicy.from_pretrained("waleo-act-pusht")

# 训练循环
obs, _ = vec_env.reset()
for step in range(100000):
    actions = policy.select_actions(obs)
    obs, rewards, dones, _, infos = vec_env.step(actions)

    # 收集数据用于离线训练
    # ...

vec_env.close()
```

### 7.2 仿真验证

```python
from waleo_env.tasks import make_env
from waleo_env.wrappers import RecordVideo
from waleo_policy_diffusion import DiffusionPolicy

# 创建环境并录制
env = make_env(
    task="push",
    robot_type="so100",
    render_mode="rgb_array"
)
env = RecordVideo(env, video_folder="./eval_videos")

# 加载训练好的策略
policy = DiffusionPolicy.from_pretrained("./checkpoints/push_model")

# 评估
success_count = 0
for episode in range(50):
    obs, info = env.reset()
    for step in range(500):
        action = policy.select_action(obs)
        obs, reward, terminated, truncated, info = env.step(action)

        if terminated:
            success_count += 1
            break

print(f"Success rate: {success_count / 50}")
env.close()
```

### 7.3 Sim-to-Real 迁移

```python
# 1. 在仿真中训练
from waleo_env.tasks import make_env
from waleo_env.randomization import VisualRandomization, PhysicsRandomization

sim_env = make_env("pick_place", simulation_backend="mujoco")
visual_rand = VisualRandomization(enable_lighting=True, enable_noise=True)
physics_rand = PhysicsRandomization(randomize_mass=True, randomize_friction=True)

# 使用域随机化训练
for episode in range(10000):
    physics_rand.randomize(sim_env)
    obs, info = sim_env.reset()
    # 训练...

# 2. 在真实机器人上测试
from waleo_robot import make_robot

robot = make_robot("so100")

for episode in range(10):
    obs = robot.get_observation()
    action = policy.select_action(obs)
    robot.send_action(action)
```

