### 4.7 域随机化 (`randomization/`)

#### 4.7.1 视觉随机化 (`randomization/visual.py`)

```python
class VisualRandomization:
    """视觉域随机化

    随机化：
    - 光照条件
    - 相机噪声
    - 背景图像
    - 颜色抖动
    """

    def __init__(
        self,
        enable_lighting: bool = True,
        enable_noise: bool = True,
        enable_background: bool = True,
        enable_color_jitter: bool = True
    ):
        ...

    def randomize(self, image: np.ndarray) -> np.ndarray:
        """对图像应用随机化"""
        if self.enable_lighting:
            image = self._randomize_lighting(image)
        if self.enable_noise:
            image = self._add_noise(image)
        if self.enable_color_jitter:
            image = self._jitter_color(image)
        return image
```

#### 4.7.2 物理随机化 (`randomization/physics.py`)

```python
class PhysicsRandomization:
    """物理参数随机化

    随机化：
    - 物体质量
    - 摩擦系数
    - 重力大小
    - 关节阻尼
    """

    def __init__(
        self,
        randomize_mass: bool = True,
        randomize_friction: bool = True,
        mass_range: tuple[float, float] = (0.5, 2.0),
        friction_range: tuple[float, float] = (0.5, 1.0)
    ):
        ...

    def randomize(self, env: RobotEnv) -> None:
        """对环境应用物理随机化"""
        if self.randomize_mass:
            self._randomize_object_mass(env)
        if self.randomize_friction:
            self._randomize_friction(env)
```

#### 使用示例

```python
from waleo_env.tasks import make_env
from waleo_env.randomization import VisualRandomization, PhysicsRandomization

env = make_env("pick_place")

# 添加域随机化
visual_rand = VisualRandomization(
    enable_lighting=True,
    enable_noise=True
)
physics_rand = PhysicsRandomization(
    randomize_mass=True,
    randomize_friction=True
)

# 训练时每个 episode 都随机化
for episode in range(1000):
    physics_rand.randomize(env)
    obs, info = env.reset()

    for step in range(500):
        action = policy.predict(obs)
        obs, reward, terminated, truncated, info = env.step(action)

        # 对图像应用视觉随机化
        if "observation.image" in obs:
            obs["observation.image"] = visual_rand.randomize(obs["observation.image"])
```

