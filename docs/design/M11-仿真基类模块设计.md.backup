#### 4.5.5 ManiSkill 后端 (`backends/maniskill.py`)

```python
class ManiSkillBackend(SimulationBackend):
    """ManiSkill 仿真后端

    特点：
    - 基于 SAPIEN 引擎
    - 专业的机器人操作仿真
    - 支持复杂物理交互
    - 丰富的操作任务库
    - GPU 加速渲染和物理
    - 支持并行仿真
    """

    def __init__(
        self,
        task: str = "PickCube",
        num_envs: int = 1,
        enable_visual_obs: bool = True,
        **kwargs
    ):
        """
        Args:
            task: ManiSkill 任务名称
                - PickCube: 抓取立方体
                - PushCube: 推动立方体
                - StackCube: 堆叠立方体
                - PlugCharger: 插入充电器
                - TurnFaucet: 转动水龙头
                - OpenCabinetDrawer: 打开抽屉
            num_envs: 并行环境数量
            enable_visual_obs: 启用视觉观察
        """
        try:
            import maniskill2_api
            import sapien.core as sapien
        except ImportError:
            raise ImportError(
                "ManiSkill requires maniskill2-api and sapien. "
                "Install with: pip install maniskill2-api sapien"
            )

        self.task = task
        self.num_envs = num_envs

        # 创建 ManiSkill 环境
        self.env = maniskill2_api.create_environment(
            task=task,
            num_envs=num_envs,
            enable_visual_obs=enable_visual_obs,
            **kwargs
        )

        # 获取环境信息
        self.observation_space = self.env.observation_space
        self.action_space = self.env.action_space

    def reset(self, seed: int | None = None) -> tuple:
        """重置环境

        Returns:
            observation: 观察数据
                - 包含机器人关节位置、速度
                - 物体位置、姿态
                - 可选：RGB-D 图像
            info: 额外信息
        """
        obs = self.env.reset()
        return obs, {}

    def step(self, action: np.ndarray) -> tuple:
        """执行一步

        Args:
            action: 动作（机器人关节位置或速度）

        Returns:
            observation: 新观察
            reward: 奖励
            terminated: 是否完成任务
            truncated: 是否超时
            info: 额外信息
        """
        obs, reward, terminated, info = self.env.step(action)
        truncated = False  # ManiSkill 使用 terminated
        return obs, reward, terminated, truncated, info

    def render(self, mode: str = "rgb_array") -> np.ndarray | None:
        """渲染环境

        Args:
            mode: "rgb_array" 返回图像数组，"human" 显示窗口

        Returns:
            图像数组（如果是 rgb_array 模式）
        """
        if mode == "rgb_array":
            return self.env.render(mode="cameras")
        elif mode == "human":
            self.env.render(mode="viewer")
            return None

    def close(self) -> None:
        """关闭环境"""
        self.env.close()

    def get_state(self) -> dict:
        """获取环境状态"""
        return {
            "observation_space": self.observation_space,
            "action_space": self.action_space,
            "num_envs": self.num_envs,
        }

    @property
    def supported_tasks(self) -> list[str]:
        """获取支持的任务列表"""
        return [
            "PickCube",
            "PushCube",
            "StackCube",
            "PlugCharger",
            "TurnFaucet",
            "OpenCabinetDrawer",
        ]
```

#### ManiSkill 任务说明

| 任务名称 | 描述 | 动作空间 | 难度 |
|---------|------|---------|------|
| `PickCube` | 从桌子上抓取立方体 | 7-DOF 位置控制 | ⭐ |
| `PushCube` | 推动立方体到目标位置 | 7-DOF 位置控制 | ⭐ |
| `StackCube` | 将立方体堆叠起来 | 7-DOF 位置控制 | ⭐⭐ |
| `PlugCharger` | 将充电器插入插座 | 7-DOF 位置控制 | ⭐⭐⭐ |
| `TurnFaucet` | 转动水龙头 | 7-DOF 位置控制 | ⭐⭐ |
| `OpenCabinetDrawer` | 打开抽屉 | 7-DOF 位置控制 | ⭐⭐ |

#### 使用示例

```python
from waleo_env.tasks import make_env

# 使用 ManiSkill 后端
env = make_env(
    task="pick_place",
    simulation_backend="maniskill",
    maniskill_task="PickCube",  # ManiSkill 任务
    num_envs=8,  # 并行环境
    enable_visual_obs=True
)

obs, info = env.reset()
for step in range(1000):
    action = policy.predict(obs)
    obs, reward, terminated, truncated, info = env.step(action)

    if terminated:
        print("Task completed!")
        obs, info = env.reset()

env.close()
```

