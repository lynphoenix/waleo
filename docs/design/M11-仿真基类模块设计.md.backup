### 4.5 仿真后端 (`backends/`)

#### 4.5.1 后端接口

```python
class SimulationBackend(ABC):
    """仿真后端抽象接口"""

    @abstractmethod
    def load_model(self, model_path: str) -> None:
        """加载模型"""
        ...

    @abstractmethod
    def step(self, action: np.ndarray) -> None:
        """执行仿真步"""
        ...

    @abstractmethod
    def get_state(self) -> dict:
        """获取环境状态"""
        ...

    @abstractmethod
    def render(self, mode: str = "rgb_array") -> np.ndarray | None:
        """渲染环境"""
        ...

    @abstractmethod
    def close(self) -> None:
        """关闭仿真"""
        ...
```

#### 4.5.2 MuJoCo 后端 (`backends/mujoco.py`)

```python
class MuJoCoBackend(SimulationBackend):
    """MuJoCo 仿真后端

    特点：
    - 快速物理仿真
    - 丰富的机器人模型库
    - 支持域随机化
    """

    def __init__(self, model_path: str, **kwargs):
        import mujoco
        self.model = mujoco.MjModel.from_xml_path(model_path)
        self.data = mujoco.MjData(self.model)
        ...

    def step(self, action: np.ndarray) -> None:
        self.data.ctrl[:] = action
        mujoco.mj_step(self.model, self.data)

    def render(self, mode: str = "rgb_array") -> np.ndarray | None:
        if mode == "rgb_array":
            return self._render_offscreen()
        elif mode == "human":
            self._render_window()
```

#### 4.5.3 Isaac Gym 后端 (`backends/isaacgym.py`)

```python
class IsaacGymBackend(SimulationBackend):
    """Isaac Gym 仿真后端

    特点：
    - GPU 加速仿真
    - 支持大规模并行（数千个环境）
    - 适合大规模训练
    """

    def __init__(self, model_path: str, num_envs: int = 1, **kwargs):
        from isaacgym import gymapi
        self.gym = gymapi.acquire_gym()
        self.num_envs = num_envs
        ...

    def step(self, action: np.ndarray) -> None:
        # 并行执行多个环境
        self.gym.simulate(self.sim)
```

