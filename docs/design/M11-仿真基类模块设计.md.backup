## 5. 模块接口

### 5.1 公开 API (`__init__.py`)

```python
# 环境基类（Gym/Gymnasium 兼容）
from waleo_sim.base import (
    BaseEnv,
    EnvWrapper,
    VectorEnv,
    RobotEnv,
)

# 任务环境
from waleo_sim.tasks import PushEnv, PickPlaceEnv, ReachEnv

# 工厂函数
from waleo_sim.tasks import make_env, make_vec_env, get_all_tasks

# 后端
from waleo_sim.backends import (
    SimulationBackend,
    MuJoCoBackend,
    IsaacGymBackend,
    PyBulletBackend,
)

# 包装器
from waleo_sim.wrappers import (
    RecordVideo,
    GrayScaleObservation,
    ResizeObservation,
)

# 域随机化
from waleo_sim.randomization import (
    VisualRandomization,
    PhysicsRandomization,
)

# 工具函数
from waleo_sim.utils import (
    get_camera_intrinsics,
    get_camera_extrinsics,
    project_point_to_image,
    compute_distance_reward,
    compute_sparse_reward,
)
```

### 5.2 版本信息

```python
__version__ = "0.1.0"
```

