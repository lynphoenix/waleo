FROM nvidia/cuda:12.4.0-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

WORKDIR /workspace

# 使用清华镜像源
RUN sed -i 's|http://archive.ubuntu.com|https://mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list && \
    sed -i 's|http://security.ubuntu.com|https://mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list

# 安装基础依赖和 OpenGL 库
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-dev \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    wget \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# 使用国内 PyPI 镜像
RUN pip3 config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple

# 升级 pip 并安装依赖
RUN pip3 install --upgrade pip && \
    pip3 install gymnasium stable-baselines3 tensorboard pytest torch

# 安装 ManiSkill
RUN pip3 install mani-skill==3.0.0b22

# 预下载 PhysX 库到容器内（避免运行时下载）
RUN mkdir -p /root/.sapien/physx && \
    cd /root/.sapien/physx && \
    wget -q https://github.com/sapien-sim/physx-precompiled/releases/download/105.1-physx-5.3.1.patch0/linux-so.zip && \
    unzip -o linux-so.zip && \
    rm linux-so.zip

CMD ["/bin/bash"]
